# Copy to `.env` for local docker runs. On Render, set these in the service Environment UI
# (or via scripts/configure_render.ps1 with a Render *account* API key).
#
# Worker auth (required for POST /v1/jobs):
API_KEY=replace-with-a-long-random-secret
#
# Optional overrides (defaults match Dockerfile / render.yaml):
# MAX_CONCURRENT_JOBS=1
# SIM_TIMEOUT_SECONDS=900
# MAX_UPLOAD_MB=50
# JOB_TTL_HOURS=24
# ENERGYPLUS_EXE=/opt/EnergyPlus-26-1-0/energyplus
# JOB_ROOT=/var/lib/eplus-worker/jobs
